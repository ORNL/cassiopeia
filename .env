# ─────────────────────────────────────────────────────────────────
# Cassiopeia — environment configuration
# Copy this file to .env and fill in the values you need.
# ─────────────────────────────────────────────────────────────────

# ── Authentication (Globus) ───────────────────────────────────────────────────
# When disabled, the API trusts an X-User-ID header and the dashboard shows a
# name box — local development only, never for a deployment reachable by others.
GLOBUS_AUTH_ENABLED=false

# Registered at https://app.globus.org/settings/developers
GLOBUS_CLIENT_ID=

# NOTE: this file is tracked in git — do NOT put the client secret here.
# Supply it from the deployment environment instead, e.g.
#   GLOBUS_CLIENT_SECRET=... docker compose up
# or via an untracked .env.local / your secret store.
#GLOBUS_CLIENT_SECRET=

# Where Globus sends the browser back after sign-in; must exactly match one of
# the redirect URIs registered on the client above.
GLOBUS_REDIRECT_URI=http://localhost:5173

# Optional allowlist: comma-separated Globus Group UUIDs. When set, an
# authenticated identity in none of these groups is rejected with 403.
#GLOBUS_ALLOWED_GROUPS=

# ── Secrets at rest ───────────────────────────────────────────────────────────
# Encrypts the per-researcher LLM API keys in user_settings.db. Without it the
# key is derived from the host MAC address, so the store cannot be moved between
# machines. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this out of git as well — supply it from the environment.
#CASSIOPEIA_SETTINGS_SECRET=

# ── LLM ───────────────────────────────────────────────────────────────────────
# API keys and active provider are configured per-researcher in the Settings UI
# (🔑 button in the dashboard).  The vars below are optional admin-level overrides.

# Set to "false" to disable LLM scoring globally (falls back to keyword matching)
LLM_SCORING_ENABLED=true

# ── LLM: chat interface (powers the Chainlit conversation) ──
# Use a capable model here; falls back to claude-haiku if unset.
LLM_CHAT_MODEL=anthropic/claude-sonnet-4-6

# Max simultaneous LLM calls during paper scoring (default 3)
#LLM_CONCURRENCY=3

# ── Per-provider model overrides (optional — hardcoded defaults shown) ─────────
# Scoring models are called once per paper (fast/cheap); reasoning models drive
# synthesis and critique (more capable).  Only set these to override the defaults.
#ANTHROPIC_SCORING_MODEL=anthropic/claude-haiku-4-5-20251001
#ANTHROPIC_REASONING_MODEL=anthropic/claude-sonnet-4-6

#AMSC_SCORING_MODEL=anthropic/claude-haiku-4-5
#AMSC_REASONING_MODEL=anthropic/claude-sonnet-4-6

#AZURE_SCORING_MODEL=azure/gpt-4
#AZURE_REASONING_MODEL=azure/gpt-4

# ── Chainlit chat interface ──
# URL where the Chainlit server is reachable from the browser.
# In development this is typically http://localhost:8001
# In production set this to the public URL of your Chainlit deployment.
CHAINLIT_URL=http://localhost:8001

# ── Monitoring cadence ──
# How often the background monitor rescans all sources (in hours, default 24)
SCAN_INTERVAL_HOURS=24

# ── Persistence ──
# Path to the SQLite database file. Leave blank to use cassiopeia.db in project root.
#DB_PATH=/path/to/custom/cassiopeia.db

# Path to the ChromaDB persistence directory (default: chroma_db/ in project root)
#RAG_PERSIST_DIR=/path/to/custom/chroma_db

# Path to the per-user settings database (API keys, active provider).
# Docker Compose sets this to /app/data/user_settings.db (on the named volume).
# Local dev defaults to ~/.cassiopeia/user_settings.db — no need to set this.
#CASSIOPEIA_SETTINGS_DB=/path/to/user_settings.db


# ── Facility equipment ──
# Comma-separated list of instruments available at the facility.
# Used for (1) LLM method_match scoring and (2) proposal feasibility assessment.
# Not injected into search queries.
# Example (APPL @ ORNL):
FACILITY_EQUIPMENT=VNIR hyperspectral imaging,SWIR hyperspectral imaging,chlorophyll fluorescence imaging,Fv/Fm,thermal imaging,3D laser scanning,RGB imaging,root imaging,automated drought stress,gravimetric water content,multispectral fluorescence

# ── API server ──
API_PORT=8000
CHAINLIT_PORT=8001
# Internal URL used by chainlit_app.py to reach the API server (server-side)
API_BASE_URL=http://localhost:8000
# URL where the React dashboard is served (used to build the link shown in chat after a search)
DASHBOARD_URL=http://localhost:5173

# ── MCP server (mcp_server.py — for integration with APPL-Agent) ──
# Host and port for the Streamable HTTP MCP endpoint (/mcp).
# When running alongside APPL-Agent, set MCP_HOST to the hostname that
# APPL-Agent can reach (e.g. the container service name in Docker Compose).
MCP_HOST=localhost
MCP_PORT=8002
